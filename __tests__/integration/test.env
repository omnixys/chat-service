DOTENV_CONFIG_PATH=/dev/null
NODE_ENV=test
LOG_LEVEL=fatal
LOG_CONSOLE_LEVEL=silent
LOG_OTEL_LEVEL=silent
PROMETHEUS_ENABLE=false
OTEL_SDK_DISABLED=true
OTEL_LOGS_ENABLED=false
LOG_BATCH_ENABLE=false

# Keycloak (test JWKS)
KC_URL=http://127.0.0.1:8080
KC_REALM=integration
KC_CLIENT_ID=nexys
KC_CLIENT_SECRET=test-secret
KC_AUDIENCE=chat-service

# Security
ENCRYPTION_KEY=45f31eb50858659cdea737527cf3a7db53062fc5c9976fa85b6a8deaad3758a2
COOKIE_SECRET=omnixys-integration-test-secret

# Gateway (test double reachable through the harness provider)
GATEWAY_BASE_URL=http://127.0.0.1:8080
GATEWAY_API_KEY=test-provider-key

# Valkey
VALKEY_PASSWORD=test-valkey-password

# Kafka
KAFKA_BROKER=localhost:9092

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat

# Domain
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Empty external readiness probes
KEYCLOAK_HEALTH_URL=
TEMPO_HEALTH_URL=
PROMETHEUS_HEALTH_URL=